diff --git a/kernel/selinux/selinux.c b/kernel/selinux/selinux.c
index a31bfb1c..e112e793 100644
--- a/kernel/selinux/selinux.c
+++ b/kernel/selinux/selinux.c
@@ -163,6 +163,23 @@ void cache_sid(void)
     } else {
         pr_info("Cached ksu_file SID: %u\n", ksu_file_sid);
     }
+
+#ifdef CONFIG_KSU_SUSFS
+    {
+        extern u32 susfs_ksu_sid;
+        extern u32 susfs_priv_app_sid;
+        static const char priv_app_ctx[] = "u:r:priv_app:s0";
+
+        susfs_ksu_sid = cached_su_sid;
+        err = security_secctx_to_secid(priv_app_ctx, strlen(priv_app_ctx), &susfs_priv_app_sid);
+        if (err) {
+            pr_warn("susfs: failed to cache priv_app SID: %d\n", err);
+            susfs_priv_app_sid = 0;
+        } else {
+            pr_info("susfs: cached priv_app SID: %u (ksu SID: %u)\n", susfs_priv_app_sid, susfs_ksu_sid);
+        }
+    }
+#endif
 }
 
