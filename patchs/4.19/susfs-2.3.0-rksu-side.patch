diff --git a/kernel/feature/susfs_glue.c b/kernel/feature/susfs_glue.c
new file mode 100644
index 00000000..2e7ea141
--- /dev/null
+++ b/kernel/feature/susfs_glue.c
@@ -0,0 +1,121 @@
+/* SUSFS <-> KernelSU integration glue for this (multi-manager) KSU fork.
+ *
+ * fs/susfs.c and the in-kernel susfs hooks are compiled as separate objects
+ * and rely on a few symbols provided by KernelSU:
+ *   - ksu_cred                     (defined in ksu.c)
+ *   - setup_selinux(domain, cred)  (defined in selinux/selinux.c)
+ *   - susfs_is_current_ksu_domain()(defined here, wraps is_ksu_domain())
+ *   - try_umount(mnt, flags)       (exposed in feature/kernel_umount.c)
+ *
+ * The susfs userspace tool (ksu_susfs) talks to the kernel through the same
+ * reboot() supercall channel this fork uses for its manager:
+ *   syscall(SYS_reboot, KSU_INSTALL_MAGIC1 (0xDEADBEEF),
+ *           SUSFS_MAGIC (0xFAFAFAFA), CMD_SUSFS_*, &info)
+ * So susfs is dispatched from ksu_handle_sys_reboot() in
+ * supercall/supercall.c when magic2 == SUSFS_MAGIC (see ksu_susfs_handle_reboot
+ * below). The tool pre-sets info.err = ERR_CMD_NOT_SUPPORTED and reads it back
+ * to decide whether the kernel handled the command.
+ */
+#ifdef CONFIG_KSU_SUSFS
+#include <linux/susfs.h>
+#include <linux/uaccess.h>
+#include <linux/cred.h>
+#include <linux/uidgid.h>
+
+/* SELinux SIDs used by the avc-log-spoofing hook in security/selinux/avc.c.
+ * Populated from cache_sid() (selinux/selinux.c) once policy is loaded. */
+u32 susfs_ksu_sid;
+u32 susfs_priv_app_sid;
+
+bool susfs_is_current_ksu_domain(void)
+{
+	return is_ksu_domain();
+}
+
+/* Dispatch a susfs command arriving over the reboot() supercall channel.
+ * @cmd is the CMD_SUSFS_* selector, @user_info points at the userspace struct
+ * pointer (matching the void __user ** signature the susfs fs helpers expect).
+ * Returns true if the command was recognised and handled. The susfs helpers
+ * write the result back into the caller's struct (info.err), which is what the
+ * ksu_susfs tool actually inspects. */
+bool ksu_susfs_handle_reboot(unsigned int cmd, void __user **user_info)
+{
+	/* Only root (the ksu_susfs tool) is allowed to configure susfs. */
+	if (!uid_eq(current_uid(), GLOBAL_ROOT_UID))
+		return false;
+
+	switch (cmd) {
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+	case CMD_SUSFS_ADD_SUS_PATH:
+		susfs_add_sus_path(user_info);
+		return true;
+	case CMD_SUSFS_ADD_SUS_PATH_LOOP:
+		susfs_add_sus_path_loop(user_info);
+		return true;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+	case CMD_SUSFS_HIDE_SUS_MNTS_FOR_NON_SU_PROCS:
+		susfs_set_hide_sus_mnts_for_non_su_procs(user_info);
+		return true;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+	case CMD_SUSFS_ADD_SUS_KSTAT:
+	case CMD_SUSFS_ADD_SUS_KSTAT_STATICALLY:
+		susfs_add_sus_kstat(user_info);
+		return true;
+	case CMD_SUSFS_UPDATE_SUS_KSTAT:
+		susfs_update_sus_kstat(user_info);
+		return true;
+#endif
+#ifdef CONFIG_KSU_SUSFS_TRY_UMOUNT
+	case CMD_SUSFS_ADD_TRY_UMOUNT:
+		susfs_add_try_umount(user_info);
+		return true;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_UNAME
+	case CMD_SUSFS_SET_UNAME:
+		susfs_set_uname(user_info);
+		return true;
+#endif
+#ifdef CONFIG_KSU_SUSFS_ENABLE_LOG
+	case CMD_SUSFS_ENABLE_LOG:
+		susfs_enable_log(user_info);
+		return true;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+	case CMD_SUSFS_SET_CMDLINE_OR_BOOTCONFIG:
+		susfs_set_cmdline_or_bootconfig(user_info);
+		return true;
+#endif
+#ifdef CONFIG_KSU_SUSFS_OPEN_REDIRECT
+	case CMD_SUSFS_ADD_OPEN_REDIRECT:
+		susfs_add_open_redirect(user_info);
+		return true;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_MAP
+	case CMD_SUSFS_ADD_SUS_MAP:
+		susfs_add_sus_map(user_info);
+		return true;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_MEMFD
+	case CMD_SUSFS_ADD_SUS_MEMFD:
+		susfs_add_sus_memfd(user_info);
+		return true;
+#endif
+	case CMD_SUSFS_ENABLE_AVC_LOG_SPOOFING:
+		susfs_set_avc_log_spoofing(user_info);
+		return true;
+	case CMD_SUSFS_SHOW_VERSION:
+		susfs_show_version(user_info);
+		return true;
+	case CMD_SUSFS_SHOW_ENABLED_FEATURES:
+		susfs_get_enabled_features(user_info);
+		return true;
+	case CMD_SUSFS_SHOW_VARIANT:
+		susfs_show_variant(user_info);
+		return true;
+	default:
+		return false;
+	}
+}
+#endif // CONFIG_KSU_SUSFS
